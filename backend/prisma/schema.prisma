generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String    @map("passwordHash")
  firstName         String    @map("firstName")
  lastName          String    @map("lastName")
  role              String    @default("CUSTOMER")
  status            String    @default("ACTIVE")
  phone             String?
  avatarUrl         String?   @map("avatarUrl")
  address           Json?
  lastLoginAt       DateTime? @map("lastLoginAt")
  createdAt         DateTime  @default(now()) @map("createdAt")
  updatedAt         DateTime  @updatedAt @map("updatedAt")
  
  policies          Policy[]
  claims            Claim[]
  payments          Payment[]
  supportTickets    SupportTicket[]
  supportResponses  SupportResponse[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  createdApprovalRules ApprovalRule[]
  requestedApprovals   ApprovalRequest[]
  delegatedApprovals   ApprovalDelegation[] @relation("delegator")
  receivedDelegations  ApprovalDelegation[] @relation("delegate")
  approvalHistory      ApprovalHistory[]
  
  @@map("users")
}

model Policy {
  id                    String    @id @default(cuid())
  policyNumber          String    @unique @map("policyNumber")
  userId                String    @map("userId")
  type                  String
  status                String    @default("PENDING_UNDERWRITING")
  coverageAmount        Float     @map("coverageAmount")
  premium               Float
  premiumFrequency      String?   @map("premiumFrequency")
  adjustedPremium       Float?    @map("adjustedPremium")
  underwriterNotes      String?   @map("underwriterNotes")
  customerDecision      String?   @map("customerDecision")
  customerDecisionDate  DateTime? @map("customerDecisionDate")
  customerDecisionNotes String?   @map("customerDecisionNotes")
  negotiationHistory    Json?     @map("negotiationHistory")
  effectiveDate         DateTime? @map("effectiveDate")
  expirationDate        DateTime? @map("expirationDate")
  approvedBy            String?   @map("approvedBy")
  approvedAt            DateTime? @map("approvedAt")
  rejectionReason       String?   @map("rejectionReason")
  rejectedAt            DateTime? @map("rejectedAt")
  riskScore             Int?      @map("riskScore")
  riskLevel             String?   @map("riskLevel")
  riskFactors           Json?     @map("riskFactors")
  riskRecommendation    String?   @map("riskRecommendation")
  productDetails        Json?     @map("productDetails")
  policyDocumentPath     String?   @map("policyDocumentPath")
  createdAt             DateTime  @default(now()) @map("createdAt")
  updatedAt             DateTime  @updatedAt @map("updatedAt")
  
  user                  User      @relation(fields: [userId], references: [id])
  claims                Claim[]
  payments              Payment[]
  endorsements          Endorsement[]
  
  @@map("policies")
}

model Claim {
  id                   String    @id @default(cuid())
  claimNumber          String    @unique @map("claimNumber")
  policyId             String    @map("policyId")
  userId               String    @map("userId")
  status               String    @default("SUBMITTED")
  incidentDate         DateTime  @map("incidentDate")
  incidentDescription  String    @map("incidentDescription")
  location             String?
  estimatedAmount      Float?    @map("estimatedAmount")
  approvedAmount       Float?    @map("approvedAmount")
  natureOfLoss         String?   @map("natureOfLoss")
  assignedTo           String?   @map("assignedTo")
  reviewedBy           String?   @map("reviewedBy")
  reviewedAt           DateTime? @map("reviewedAt")
  submittedDate        DateTime  @default(now()) @map("submittedDate")
  createdAt            DateTime  @default(now()) @map("createdAt")
  updatedAt            DateTime  @updatedAt @map("updatedAt")
  
  user                 User      @relation(fields: [userId], references: [id])
  policy               Policy    @relation(fields: [policyId], references: [id])
  timeline             ClaimTimeline[]
  documents            ClaimDocument[]
  
  @@map("claims")
}

model ClaimTimeline {
  id        String   @id @default(cuid())
  claimId   String   @map("claimId")
  date      DateTime
  status    String
  note      String?
  createdAt DateTime @default(now()) @map("createdAt")
  
  claim     Claim    @relation(fields: [claimId], references: [id])
  
  @@map("claim_timeline")
}

model ClaimDocument {
  id          String   @id @default(cuid())
  claimId     String   @map("claimId")
  documentUrl String   @map("documentUrl")
  documentType String  @map("documentType")
  description String?
  uploadedAt  DateTime @default(now()) @map("uploadedAt")
  
  claim       Claim    @relation(fields: [claimId], references: [id])
  
  @@map("claim_documents")
}

model Payment {
  id            String   @id @default(cuid())
  policyId      String   @map("policyId")
  userId        String   @map("userId")
  amount        Float
  paymentMethod String?  @map("paymentMethod")
  referenceNumber String? @map("referenceNumber")
  transactionId String?  @map("transactionId")
  status        String   @default("PENDING")
  paidAt        DateTime? @map("paidAt")
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
  
  policy        Policy   @relation(fields: [policyId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  
  @@map("payments")
}

model SupportTicket {
  id            String   @id @default(cuid())
  ticketNumber  String   @unique @map("ticketNumber")
  userId        String   @map("userId")
  subject       String
  description   String
  priority      String   @default("MEDIUM")
  status        String   @default("OPEN")
  resolvedAt    DateTime? @map("resolvedAt")
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")
  
  user          User     @relation(fields: [userId], references: [id])
  responses     SupportResponse[]
  
  @@map("support_tickets")
}

model SupportResponse {
  id        String   @id @default(cuid())
  ticketId  String   @map("ticketId")
  userId    String   @map("userId")
  message   String
  createdAt DateTime @default(now()) @map("createdAt")
  
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
  user      User          @relation(fields: [userId], references: [id])
  
  @@map("support_responses")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("userId")
  action     String
  entityType String?  @map("entityType")
  entityId   String?  @map("entityId")
  oldValues  Json?    @map("oldValues")
  newValues  Json?    @map("newValues")
  ipAddress  String?  @map("ipAddress")
  userAgent  String?  @map("userAgent")
  createdAt  DateTime @default(now()) @map("createdAt")
  
  user       User?    @relation(fields: [userId], references: [id])
  
  @@map("audit_logs")
}

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("userId")
  title     String
  message   String
  type      String    @default("system")
  isRead    Boolean   @default(false) @map("isRead")
  readAt    DateTime? @map("readAt")
  createdAt DateTime  @default(now()) @map("createdAt")
  updatedAt DateTime  @updatedAt @map("updatedAt")

  user      User      @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model Endorsement {
  id               String   @id @default(cuid())
  policyId         String   @map("policyId")
  endorsementNumber String  @unique @map("endorsementNumber")
  type             String
  changes          Json
  reason           String?
  status           String   @default("PENDING")
  requestedBy      String?  @map("requestedBy")
  requestedAt      DateTime @default(now()) @map("requestedAt")
  reviewedBy       String?  @map("reviewedBy")
  reviewedAt       DateTime? @map("reviewedAt")
  approvedBy       String?  @map("approvedBy")
  approvedAt       DateTime? @map("approvedAt")
  notes            String?
  createdAt        DateTime @default(now()) @map("createdAt")
  updatedAt        DateTime @updatedAt @map("updatedAt")
  
  policy           Policy   @relation(fields: [policyId], references: [id])
  
  @@map("endorsements")
}

model RoleLevel {
  id              String   @id @default(cuid())
  department      String
  levelName       String   @map("level_name")
  levelCode       String   @unique @map("level_code")
  levelOrder      Int      @map("level_order")
  canApprove      Boolean  @default(true) @map("can_approve")
  canReject       Boolean  @default(true) @map("can_reject")
  maxAmountLimit  Float?   @map("max_amount_limit")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("role_levels")
}

model ApprovalRule {
  id              String   @id @default(cuid())
  ruleName        String   @map("rule_name")
  productType     String   @map("product_type")
  minSumInsured   Float?   @map("min_sum_insured")
  maxSumInsured   Float?   @map("max_sum_insured")
  minRiskScore    Float?   @map("min_risk_score")
  maxRiskScore    Float?   @map("max_risk_score")
  approvalLevels  Json     @map("approval_levels") // Array of role_level_ids
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator         User     @relation(fields: [createdBy], references: [id])

  @@map("approval_rules")
}

model ApprovalRequest {
  id              String   @id @default(cuid())
  requestNumber   String   @unique @map("request_number")
  entityType      String   @map("entity_type") // 'POLICY' | 'CLAIM' | 'PAYMENT'
  entityId        String   @map("entity_id")
  requestedBy     String   @map("requested_by")
  currentLevel    String   @map("current_level") // role_level_id
  status          String   @default("PENDING") @map("status")
  priority        String   @default("NORMAL") @map("priority")
  approvalMetadata Json?   @map("approval_metadata")
  submittedAt     DateTime @default(now()) @map("submitted_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  requester       User     @relation(fields: [requestedBy], references: [id])
  history         ApprovalHistory[]

  @@map("approval_requests")
}

model ApprovalDelegation {
  id          Int      @id @default(autoincrement())
  delegatorId String   @map("delegator_id")
  delegateId  String   @map("delegate_id")
  entityType  String   @map("entity_type") // 'USER' or specific entity type
  startDate   DateTime @map("start_date")
  endDate     DateTime @map("end_date")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  delegator   User     @relation("delegator", fields: [delegatorId], references: [id])
  delegate    User     @relation("delegate", fields: [delegateId], references: [id])

  @@map("approval_delegations")
}

model ApprovalHistory {
  id            String   @id @default(cuid())
  requestId     String   @map("request_id")
  approvedBy    String   @map("approved_by")
  approvalLevel String   @map("approval_level") // role_level_id
  decision      String   @map("decision") // 'APPROVED' | 'REJECTED' | 'REQUIRES_MODIFICATION'
  notes         String?  @map("notes")
  approvedAt    DateTime @default(now()) @map("approved_at")
  createdAt     DateTime @default(now()) @map("created_at")

  request       ApprovalRequest @relation(fields: [requestId], references: [id])
  approver      User            @relation(fields: [approvedBy], references: [id])

  @@map("approval_history")
}