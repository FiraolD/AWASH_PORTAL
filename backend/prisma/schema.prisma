generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Reconciled against Neon production. The running application currently uses pg/raw SQL.
// Do NOT run Prisma migrations against production until a migration baseline is deliberately established.

model ApprovalHistory {
  id String @id @default(dbgenerated("gen_random_uuid()"))
  requestId String?
  approvedBy String?
  approvalLevel String?
  decision String
  notes String?
  approvedAt DateTime?
  createdAt DateTime?

  @@map("approval_history")
}

model ApprovalRequest {
  id String @id @default(dbgenerated("gen_random_uuid()"))
  requestNumber String
  entityType String
  entityId String
  requestedBy String?
  currentLevel String?
  status String?
  priority String?
  approvalMetadata Json?
  submittedAt DateTime?
  createdAt DateTime?
  updatedAt DateTime?

  @@unique([requestNumber])

  @@map("approval_requests")
}

model ApprovalRule {
  id String @id @default(dbgenerated("gen_random_uuid()"))
