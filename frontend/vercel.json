{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://awash-portal.onrender.com/api/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://awash-portal.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}